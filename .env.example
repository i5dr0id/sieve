# Sieve configuration — copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# .env is gitignored and must NEVER be committed. These are YOUR keys.
# The desk runs with none of these set (it falls back to public endpoints, which are
# slower and rate-limited). Helius + Rugcheck are the two worth adding first.

# --- your bot wallet (PUBLIC address only; the secret key lives in ~/.sieve/hotwallet.json) ---
# create the wallet with:  python newwallet.py   (it prints the public address)
WALLET_ADDRESS=YOUR_WALLET_PUBLIC_ADDRESS_HERE
# profit sweeps go ONLY here (your main wallet's PUBLIC address). sweep.py / the dashboard's Sweep button
SWEEP_TO_ADDRESS=YOUR_MAIN_WALLET_PUBLIC_ADDRESS_HERE

# --- RPC: how the desk reads the chain and sends trades ---
# Helius (recommended, free tier at https://helius.dev) — used as the primary RPC.
# Paste the FULL url they give you, including the ?api-key=... part.
HELIUS_API_KEY=your_helius_api_key_here
# Optional backup RPC url (e.g. FluxRPC https://fluxrpc.com). Full url. Leave blank to skip.
FLUXRPC_RPC=

# --- Rugcheck: the risk data behind the 13 checks (recommended) ---
# free key at https://rugcheck.xyz — sent as a header. Public access works without it but is limited.
RUGCHECK_API=your_rugcheck_api_key_here

# --- optional signals / tooling ---
# Birdeye (https://birdeye.so) — trend data fed to the AI shadow judge only. Optional.
BIRDEYE_API_KEY=
# CoinGecko demo key (https://coingecko.com) — fallback price candles for backtest.py. Optional.
COINGECKO_API_KEY=
# xAI key — ONLY needed if you set JUDGE="grok" in config.py. Leave blank for the code/claude judge.
XAI_API_KEY=
